{
  "name": "dunggle",
  "version": "0.1.0",
  "private": true,
  "description": "Dunggle — application de veille technologique (Angular, IA, Agents IA)",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "pocs/*"
  ],
  "scripts": {
    "poc:sources": "npm run test:sources -w @dunggle/veille-feasibility",
    "poc:extraction": "npm run test:content -w @dunggle/veille-feasibility",
    "poc:all": "npm run poc:sources && npm run poc:extraction",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "poc:candidates": "npm run test:candidates -w @dunggle/veille-feasibility --",
    "test": "npm run test:unit -w @dunggle/veille-feasibility && npm run test -w @dunggle/ai-analysis && npm run test -w @dunggle/api",
    "poc:candidates:offline": "npm run test:candidates -w @dunggle/veille-feasibility -- --offline",
    "poc2:test": "npm run test -w @dunggle/ai-analysis",
    "poc2:prepare": "npm run prepare:eval -w @dunggle/ai-analysis",
    "poc2:budget": "npm run budget:scenarios -w @dunggle/ai-analysis",
    "poc2:evaluate": "npm run evaluate:real -w @dunggle/ai-analysis --",
    "check:secrets": "npm run check:secrets -w @dunggle/ai-analysis",
    "poc2:authorize": "npm run authorize:real -w @dunggle/ai-analysis --",
    "poc2:compare": "npm run compare -w @dunggle/ai-analysis --",
    "api:test": "npm run test -w @dunggle/api"
  }
}
